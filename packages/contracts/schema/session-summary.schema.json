{
  "$id": "https://schemas.enterprise-data-analyst.dev/session-summary/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lastActivityAt": {
      "format": "date-time",
      "title": "Lastactivityat",
      "type": "string"
    },
    "sessionId": {
      "pattern": "^ses_[A-Za-z0-9_-]{8,}$",
      "title": "Sessionid",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": ["sessionId", "title", "lastActivityAt"],
  "title": "SessionSummary",
  "type": "object"
}
