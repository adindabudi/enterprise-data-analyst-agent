APP_ENV=development
AZURITE_HEALTH_URL=http://127.0.0.1:10000/devstoreaccount1
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HEALTH_URL=http://127.0.0.1:18079/health
COSMOS_ENDPOINT=http://127.0.0.1:1234

# EDA application settings. UUIDs are documented, non-secret placeholders.
EDA_PUBLIC_ORIGIN=http://localhost:8000
EDA_ENTRA_TENANT_ID=11111111-1111-1111-1111-111111111111
EDA_ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222
EDA_MANAGED_IDENTITY_CLIENT_ID=33333333-3333-3333-3333-333333333333
EDA_COSMOS_ENDPOINT=http://127.0.0.1:1234
EDA_COSMOS_DATABASE=enterprise-data-analyst
EDA_BLOB_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
EDA_COSMOS_WORKSPACE_CONTAINER=workspace
EDA_COSMOS_AUTH_CONTAINER=auth
EDA_COSMOS_RUNTIME_CONTAINER=runtime
EDA_BLOB_QUARANTINE_CONTAINER=quarantine
EDA_BLOB_SESSIONS_CONTAINER=sessions
EDA_REDIS_URL=redis://127.0.0.1:6379/0
EDA_FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
EDA_FOUNDRY_MODEL_DEPLOYMENT=analysis-terra
EDA_MODEL_PROFILE=gpt-5.6-terra-medium-v1
EDA_FOUNDRY_HOSTING=azure

# Fabric target catalogs are worker-only. Configure exactly one catalog when enabled.
FABRIC_ENABLED=false
FABRIC_PROVIDER=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_KEY_VAULT_URL=
FABRIC_SIGNING_CERTIFICATE_NAME=
FABRIC_CACHE_WRAP_KEY_NAME=
FABRIC_SEMANTIC_MODELS_JSON=
FABRIC_ONTOLOGIES_JSON=

# Put EDA_ENTRA_CLIENT_SECRET only in an untracked local .env file. Production rejects it.